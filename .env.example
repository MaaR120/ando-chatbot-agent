PORT=8000
ENVIRONMENT=development

# Conexión a Base de Datos Local
DATABASE_URL=postgresql://postgres:password123@localhost:5432/ando_db
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password123
DB_NAME=ando_db

# LLM
# El provider puede ser groq | openai | anthropic
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
GROQ_API_KEY="your api key"
ANTHROPIC_API_KEY="you api key"

# Límites del agente (opcionales). Los valores por defecto están pensados para planes con pocos
# tokens por minuto (p. ej. Groq on_demand, 8000 TPM). Con un plan más amplio puedes subirlos.
# AGENT_DEFAULT_LIMIT=8
# AGENT_MAX_LIMIT=12
# AGENT_DESCRIPTION_MAX_CHARS=200   # 0 = descripción completa
# AGENT_MAX_ITERATIONS=10
# AGENT_HISTORY_TURNS=5          # turnos previos que se reenvían al modelo
# LLM_MAX_RETRIES=6              # reintentos ante 429 del proveedor
